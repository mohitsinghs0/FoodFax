# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Optional backend / script secret key (Do NOT expose in client bundle)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# GEMINI_API_KEY: Optional for Gemini AI features
GEMINI_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Optional API key for Google Maps Embed
VITE_GOOGLE_MAPS_API_KEY=""
